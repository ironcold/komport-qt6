[AUTHORS]
dist=true
install=false
install_location=
type=DATA

[COPYING]
dist=true
install=false
install_location=
type=DATA

[ChangeLog]
dist=true
install=false
install_location=
type=DATA

[Config for BinMakefileAm]
addcxxflags=
bin_program=komport
cflags=
cppflags=
cxxflags=\s-O0 -g3 -Wall
ldadd=\s$(LIB_KFILE) $(LIB_KDEUI) $(LIB_KDECORE) $(LIB_QT)
ldflags=\s           \s

[General]
AMChanged=false
author=Mike Sharkey
configure_args=\s--build=i386-linux --host=i386-linux --target=i386-linux\s
email=michael@sharkey.servebeer.com
kdevprj_version=1.3
lfv_open_groups=GNU,Headers,Others,Sources,User Interface
make_options=\s-j1
makefiles=Makefile.am,komport/Makefile.am,doc/Makefile.am,doc/en/Makefile.am,po/Makefile.am
modifyMakefiles=true
project_name=Komport
project_type=normal_kde2
short_info=Serial port communications and terminal emulator.
showNonProjectFiles=false
sub_dir=komport/
version=0.4.6
version_control=CVS
workspace=1

[INSTALL]
dist=true
install=false
install_location=
type=DATA

[KPP]
kpp_appgrp=Applications/Communications
kpp_bldroot=
kpp_icon=0
kpp_license=5
kpp_summary=
kpp_url=http://sharkey.servebeer.com/komport
kpp_version=0.2

[LFV Groups]
GNU=AUTHORS,COPYING,ChangeLog,INSTALL,README,TODO,NEWS
Headers=*.h,*.hh,*.hxx,*.hpp,*.H
Others=*
Sources=*.cpp,*.c,*.cc,*.C,*.cxx,*.ec,*.ecpp,*.lxx,*.l++,*.ll,*.l
Translations=*.po
User Interface=*.kdevdlg,*.ui,*.rc,*.dlg
groups=Headers,Sources,User Interface,Translations,GNU,Others

[Makefile.am]
files=komport.kdevprj,admin,AUTHORS,COPYING,ChangeLog,INSTALL,README,TODO,komport.lsm
sub_dirs=komport,po
type=normal

[README]
dist=true
install=false
install_location=
type=DATA

[TODO]
dist=true
install=false
install_location=
type=DATA

[admin]
dist=true
install=false
install_location=
type=DATA

[doc/Makefile.am]
sub_dirs=
type=normal

[doc/en/Makefile.am]
sub_dirs=
type=normal

[komport.kdevprj]
dist=true
install=false
install_location=
type=DATA

[komport.lsm]
dist=true
install=false
install_location=
type=DATA

[komport/Makefile.am]
files=komport/main.cpp,komport/komport.cpp,komport/komport.h,komport/komportdoc.cpp,komport/komportdoc.h,komport/komportview.cpp,komport/komportview.h,komport/komportui.rc,komport/komport.desktop,komport/lo32-app-komport.png,komport/lo16-app-komport.png,komport/komportserial.cpp,komport/komportserial.h,komport/komportcell.cpp,komport/komportcell.h,komport/komportcellarray.cpp,komport/komportcellarray.h,komport/komportqueue.cpp,komport/komportqueue.h,komport/komportemulation.cpp,komport/komportemulation.h,komport/komportscript.cpp,komport/komportscript.h,komport/komportscrollbuffer.cpp,komport/komportscrollbuffer.h,komport/settingsdialog.ui,komport/komporttransfer.cpp,komport/komporttransfer.h,komport/komportfilescrollbuffer.cpp,komport/komportfilescrollbuffer.h
sub_dirs=
type=prog_main

